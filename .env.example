# ── Copy to .env and fill in. NEVER commit .env. ────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (MySQL 8, utf8mb4)
# Format: mysql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="mysql://slopdar:slopdar@localhost:3306/slopdar"

# Redis (cache + rate limiting)
REDIS_URL="redis://localhost:6379"

# Scanner tuning
SCAN_FETCH_TIMEOUT_MS=10000
SCAN_MAX_BYTES=3000000
SCAN_MAX_REDIRECTS=5
SCAN_CACHE_TTL_SECONDS=86400
SCAN_USER_AGENT="SlopdarBot/0.1 (+https://slopdar.com/bot)"

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10

# Screenshots
SCREENSHOT_DIR=./public/screenshots
SCREENSHOT_TIMEOUT_MS=15000
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=800

# Set to "1" to allow scanning private/loopback hosts (LOCAL DEV ONLY — unsafe).
ALLOW_PRIVATE_HOSTS=0
