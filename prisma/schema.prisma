// Slopdar data model — see docs/05-architecture.md
// Provider: MySQL 8 (utf8mb4 set at the server level via docker-compose).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// One scan of one URL. `slug` is the public, shareable id (e.g. /r/stripe.com).
model Check {
  id         String   @id @default(cuid())
  url        String   @db.VarChar(2048) // full URL (not indexed — can exceed the utf8mb4 key limit)
  urlHash    String   @unique @db.Char(64) // sha256(url) — the canonical uniqueness key
  slug       String   @unique @db.VarChar(255)
  host       String   @db.VarChar(255)
  finalUrl   String?  @db.VarChar(2048)
  score      Int // 0–100 Slop Score
  tier       String   @db.VarChar(64) // Hand-Crafted | Suspiciously Clean | Vibe-Coded | Pure Slop
  screenshot String?  @db.VarChar(512) // public path or null if capture failed
  title      String?  @db.VarChar(512)
  scanError  String?  @db.Text // populated when the scan partially failed
  checkCount Int      @default(1) // how many times this URL has been scanned
  gameHidden Boolean  @default(false) // excluded from the daily game (unsafe/reported content)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  signals    Signal[]
  techStacks TechStack[]
  savedBy    SavedSite[]
  featuredIn FeaturedSite[]
  websiteOf  User[]         @relation("UserWebsite")

  @@index([score])
  @@index([createdAt])
  // Fast pool draw for the game: filter out hidden sites, then band by score.
  @@index([gameHidden, score])
}

/// A matched detection signal — "the receipts" shown on the result page.
model Signal {
  id          String  @id @default(cuid())
  checkId     String
  signalId    String  @db.VarChar(128) // stable rule id, e.g. "fingerprint.v0"
  category    String  @db.VarChar(64)
  label       String  @db.VarChar(255)
  description String  @db.Text
  weight      Int
  evidence    String? @db.Text // snippet / matched value, when available

  check Check @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
}

/// Detected technology (Wappalyzer-style).
model TechStack {
  id         String  @id @default(cuid())
  checkId    String
  name       String  @db.VarChar(128)
  category   String? @db.VarChar(64)
  confidence Int     @default(100)

  check Check @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@unique([checkId, name])
  @@index([checkId])
}

/// Daily tally of the Built-or-Slop prediction prompt: did first-time
/// scanners make the call or skip it? Anonymous counters only — this feeds
/// the go/no-go decision on the daily guessing game (gamification idea 5).
model GuessStat {
  day     DateTime @id @db.Date
  calls   Int      @default(0)
  correct Int      @default(0)
  skips   Int      @default(0)
}

/// Account (Google via Auth.js). Extended with the daily-game profile.
model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(320)
  emailVerified DateTime?
  name          String?   @db.VarChar(255)
  image         String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())

  // Daily game profile
  handle         String?   @unique @db.VarChar(32) // public name on the leaderboard; never the email
  websiteUrl     String?   @db.VarChar(512) // the site the player wants shown when they win
  websiteCheckId String? // that site's scanned Check, once scanned
  currentStreak  Int       @default(0) // days played in a row
  bestStreak     Int       @default(0)
  lastPlayedDay  DateTime? @db.Date // drives streak continuity

  saved    SavedSite[]
  results  PlayResult[]
  featured FeaturedSite[]
  accounts Account[]
  sessions Session[]
  website  Check?         @relation("UserWebsite", fields: [websiteCheckId], references: [id])

  @@index([websiteCheckId])
}

/// A site a logged-in user saved to their profile.
model SavedSite {
  id        String   @id @default(cuid())
  userId    String
  checkId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  check Check @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@unique([userId, checkId])
  @@index([userId])
}

/// One finished scored game. Powers every leaderboard. One per user per day.
model PlayResult {
  id         String   @id @default(cuid())
  userId     String
  day        DateTime @db.Date
  correct    Int // 0..5 answers right
  score      Int // 0..100 total score
  streak     Int // longest run of correct answers within the game
  durationMs Int // total time taken (server-measured), tie-breaker
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day, score])
}

/// A winner's website locked in to appear in a given day's games (the reward).
model FeaturedSite {
  id        String   @id @default(cuid())
  day       DateTime @db.Date // the day these sites are shown to players
  checkId   String
  userId    String
  rank      Int // 1..3, the winning place that earned it
  createdAt DateTime @default(now())

  check Check @relation(fields: [checkId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([day, rank])
  @@index([day])
}

// ── Auth.js (next-auth) Prisma adapter tables ──────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
