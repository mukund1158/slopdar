{
  "name": "slopdar",
  "version": "0.1.0",
  "private": true,
  "description": "Is it built or is it slop? — paste a URL, get a Slop Score.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "scan": "node --env-file=.env --import tsx scripts/scan.ts",
    "dedupe": "node --env-file=.env --import tsx scripts/dedupe-checks.ts",
    "reward-winners": "node --env-file=.env --import tsx scripts/reward-winners.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "playwright:install": "playwright install --with-deps chromium",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.2.0",
    "cheerio": "^1.0.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.4.2",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.31",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
